<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain HTTP only to the local dev backend (AppConfig.BASE_URL_LOCAL_LAN /
     BASE_URL_EMULATOR_LOCAL). Everything else — including the production
     Render URL — still requires HTTPS via the base-config default. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.31</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
