[Unit]
Description=Pull recent Garmin running activities into Quail Fitness
After=network.target postgresql.service

[Service]
Type=oneshot
User=trevinjc
WorkingDirectory=/home/trevinjc/webapp
EnvironmentFile=/home/trevinjc/webapp/.env
ExecStart=/home/trevinjc/webapp/.venv/bin/python /home/trevinjc/webapp/scripts/garmin_sync_runs.py
